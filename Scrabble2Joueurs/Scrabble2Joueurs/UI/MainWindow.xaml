<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Scrabble2Joueurs.MainWindow"
        Title="Scrabble 2 Joueurs" Height="560" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Background="WhiteSmoke">

        <!-- ===== ÉCRAN 1 : SAISIE DES NOMS ===== -->
        <StackPanel x:Name="EcranDepart"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="542" Height="474">

            <TextBlock Text="SCRABBLE" FontSize="42" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="DarkGreen"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Jeu à 2 joueurs" FontSize="14"
                       HorizontalAlignment="Center" Foreground="Gray"
                       Margin="0,0,0,30"/>

            <TextBlock x:Name="erreur" Text="" Foreground="Red"
                       Visibility="Hidden" Margin="0,0,0,10"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <Label Content="Nom du joueur 1 :"/>
            <TextBox x:Name="txtNomJ1" Text="Joueur 1"
                     Margin="0,0,0,14" Padding="4" FontSize="13"/>

            <Label Content="Nom du joueur 2 :"/>
            <TextBox x:Name="txtNomJ2" Text="Joueur 2"
                     Margin="0,0,0,24" Padding="4" FontSize="13"/>
            <Button x:Name="btnCommencer" Content="Commencer la partie"
                    Height="36" FontSize="14" FontWeight="Bold"
                    Background="DarkGreen" Foreground="White"
                    BorderThickness="0"
                    Click="BtnCommencer_Click"/>
            <TextBlock Text="Historique des parties" FontWeight="Bold"
                       Margin="0,14,0,4"/>
            <DataGrid x:Name="dgHistorique" Height="120"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
                    <DataGridTextColumn Header="Joueur 1" Binding="{Binding Joueur1}" Width="*"/>
                    <DataGridTextColumn Header="Score 1" Binding="{Binding Score1}" Width="Auto"/>
                    <DataGridTextColumn Header="Joueur 2" Binding="{Binding Joueur2}" Width="*"/>
                    <DataGridTextColumn Header="Score 2" Binding="{Binding Score2}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>


        <!-- ===== ÉCRAN 2 : JEU ===== -->
        <Grid x:Name="EcranJeu" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barre du haut : scores + tour -->
            <Border Grid.Row="0" Background="DarkGreen" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Joueur 1 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtNomJ1Display" Text="Joueur 1"
                                   Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="txtScoreJ1" Text="0"
                                   Foreground="Yellow" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Centre -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="txtTourActuel" Text="Tour de : Joueur 1"
                                   Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtSac" Text="86 lettres"
                                   Foreground="LightGray" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Joueur 2 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock x:Name="txtNomJ2Display" Text="Joueur 2"
                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="txtScoreJ2" Text="0"
                                   Foreground="Yellow" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chevalet -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,6">
                <TextBlock x:Name="txtRackLabel" Text="CHEVALET DE JOUEUR 1"
                           HorizontalAlignment="Center" FontWeight="Bold"
                           Foreground="Gray" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="Tuile1" Content="A" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile2" Content="B" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile3" Content="E" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile4" Content="L" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile5" Content="S" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile6" Content="T" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                    <Button x:Name="Tuile7" Content="I" Width="52" Height="52"
                            FontSize="22" FontWeight="Bold" Margin="3"
                            Background="Goldenrod" Foreground="Black"
                            Click="Tuile_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Boutons d'action -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,6,0,10">
                <Button x:Name="btnValider" Content="Valider"
                        Width="100" Height="32" Margin="6,0"
                        Background="Green" Foreground="White"
                        BorderThickness="0"
                        Click="BtnValider_Click"/>
                <Button x:Name="btnPasser" Content="Passer"
                        Width="100" Height="32" Margin="6,0"
                        Click="BtnPasser_Click"/>
                <Button x:Name="btnAnnuler" Content="Annuler"
                        Width="100" Height="32" Margin="6,0"
                        Background="Firebrick" Foreground="White"
                        BorderThickness="0"
                        Click="BtnAnnuler_Click"/>
            </StackPanel>

            <!-- Historiques des deux joueurs -->
            <Grid Grid.Row="3" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="LightGray"
                        BorderThickness="1" Margin="0,0,5,0" Padding="8">
                    <StackPanel>
                        <TextBlock x:Name="lblHistoJ1" Text="Mots de Joueur 1"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel x:Name="HistoriqueJ1"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="LightGray"
                        BorderThickness="1" Margin="5,0,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock x:Name="lblHistoJ2" Text="Mots de Joueur 2"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel x:Name="HistoriqueJ2"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bouton nouvelle partie en bas -->
            <Button Grid.Row="4" Content="Nouvelle partie"
                    HorizontalAlignment="Right" Margin="10,6"
                    Padding="10,4"
                    Click="BtnNouvellePartie_Click"/>
        </Grid>


        <!-- ===== ÉCRAN 3 : FIN DE PARTIE ===== -->
        <Grid x:Name="EcranFin" Visibility="Collapsed" Background="#CC000000"
              Panel.ZIndex="50">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" Padding="40,30" MinWidth="340"
                    BorderBrush="DarkGreen" BorderThickness="3">
                <StackPanel>
                    <TextBlock Text="Partie terminée !" FontSize="26"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="DarkGreen" Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtGagnant" Text=""
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="DarkRed" Margin="0,0,0,20"
                               TextWrapping="Wrap" TextAlignment="Center"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtFinNomJ1" Text="Joueur 1"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtFinScoreJ1" Text="0 pts"
                                       FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtFinNomJ2" Text="Joueur 2"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtFinScoreJ2" Text="0 pts"
                                       FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Rejouer" HorizontalAlignment="Center"
                            Width="140" Height="34" FontSize="14"
                            Background="DarkGreen" Foreground="White"
                            BorderThickness="0"
                            Click="BtnNouvellePartie_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>

